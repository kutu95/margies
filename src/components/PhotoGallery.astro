---
interface Image {
  src: string;
  alt: string;
  title?: string;
  caption?: string;
  location?: string;
  year?: string;
  width?: number;
  height?: number;
}

interface Props {
  images: Image[];
  eagerFirst?: boolean;
}

const { images, eagerFirst = false } = Astro.props;

function caption(image: Image): string | undefined {
  const parts = [image.caption, [image.location, image.year].filter(Boolean).join(", ")].filter(Boolean);
  return parts.length ? parts.join(" · ") : undefined;
}
---

<div class="photo-gallery" data-gallery>
  {images.map((image, index) => {
    const text = caption(image);
    const width = image.width ?? 1600;
    const height = image.height ?? 1000;
    const portrait = height > width;
    return (
      <figure class:list={["photo-figure", { "photo-figure-portrait": portrait }]}>
        <a href={image.src} data-gallery-item>
          <img
            src={image.src}
            alt={image.alt}
            width={width}
            height={height}
            loading={eagerFirst && index === 0 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={eagerFirst && index === 0 ? "high" : undefined}
            sizes={portrait ? "(min-width: 900px) 42vw, 100vw" : "(min-width: 900px) 70vw, 100vw"}
          />
        </a>
        {(image.title || text) && (
          <figcaption>
            {image.title && <strong>{image.title}</strong>}
            {image.title && text && " — "}
            {text}
          </figcaption>
        )}
      </figure>
    );
  })}

  <dialog class="lightbox" data-lightbox aria-label="Enlarged photograph">
    <form method="dialog">
      <button type="submit" class="lightbox-close" aria-label="Close">Close</button>
    </form>
    <figure>
      <img data-lightbox-image alt="" width="1600" height="1000" hidden />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    if (root.dataset.enhanced === "true") return;
    const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const image = root.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const caption = root.querySelector<HTMLElement>("[data-lightbox-caption]");
    if (!dialog || !image || !caption) return;

    root.dataset.enhanced = "true";
    root.querySelectorAll<HTMLAnchorElement>("[data-gallery-item]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const img = link.querySelector("img");
        const figcaption = link.parentElement?.querySelector("figcaption");
        image.hidden = false;
        image.src = link.href;
        image.alt = img?.alt ?? "";
        caption.textContent = figcaption?.textContent?.trim() ?? "";
        dialog.showModal();
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
