---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getPage } from "../../lib/pages";
import { getProjects } from "../../lib/projects";
import { breadcrumbJsonLd } from "../../lib/seo";

const page = await getPage("projects");
const projects = await getProjects();
const title = page.data.seoTitle ?? "Projects — John Bowskill";
const description = page.data.seoDescription ?? "";
---

<BaseLayout
  title={title}
  description={description}
  path="/projects"
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Projects", path: "/projects" },
  ])}
>
  <header class="page-hero">
    <div class="wrap">
      <p class="section-kicker">{page.data.kicker}</p>
      <h1 class="page-title">{page.data.headline}</h1>
      <p class="lede">{page.data.lede}</p>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap project-grid">
      {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
    </div>
  </section>
</BaseLayout>
