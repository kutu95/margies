---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { getPage } from "../lib/pages";
import { breadcrumbJsonLd, personJsonLd } from "../lib/seo";

const page = await getPage("about");
const { Content } = await render(page);
const title = page.data.seoTitle ?? "About John Bowskill";
const description = page.data.seoDescription ?? "";
---

<BaseLayout
  title={title}
  description={description}
  path="/about"
  image={page.data.image}
  imageAlt={page.data.imageAlt}
  jsonLd={[
    personJsonLd(),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "About John", path: "/about" },
    ]),
  ]}
>
  <header class="page-hero">
    <div class="wrap">
      <h1 class="page-title">{page.data.headline}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap about-layout">
      <figure class="portrait">
        <img
          src={page.data.image}
          alt={page.data.imageAlt ?? ""}
          width="800"
          height="705"
        />
        <figcaption>{page.data.imageCaption}</figcaption>
      </figure>

      <div class="prose">
        <Content />
        {page.data.ctaTitle && <ContactCTA href="/contact" label={page.data.ctaTitle} />}
      </div>
    </div>
  </section>
</BaseLayout>
