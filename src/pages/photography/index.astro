---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionCard from "../../components/CollectionCard.astro";
import { getPage } from "../../lib/pages";
import { getPhotographyCollections } from "../../lib/photography";
import { breadcrumbJsonLd, collectionPageJsonLd } from "../../lib/seo";

const page = await getPage("photography");
const collections = await getPhotographyCollections();
const title = page.data.seoTitle ?? "Photography — John Bowskill";
const description = page.data.seoDescription ?? "";
const path = "/photography";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={page.data.heroImage}
  imageAlt={page.data.heroAlt}
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Photography", path },
    ]),
    collectionPageJsonLd({
      name: "Photography",
      description,
      path,
      images: collections.map((collection) => ({
        src: collection.data.hero,
        alt: collection.data.heroAlt,
      })),
    }),
  ]}
>
  <header class="page-hero">
    <div class="wrap">
      <p class="section-kicker">{page.data.kicker}</p>
      <h1 class="page-title">{page.data.headline}</h1>
      <p class="lede lede-wide">{page.data.lede}</p>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap collection-grid">
      {collections.map((collection) => (
        <CollectionCard collection={collection} headingLevel="h2" />
      ))}
    </div>
  </section>
</BaseLayout>
