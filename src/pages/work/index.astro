---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { breadcrumbJsonLd } from "../../lib/seo";

const title = "Interactive works | John Bowskill";
const description = "Explore Captain Godfrey, Cuborama, Drift and Layer Painter, combining art, storytelling, software and physical interaction.";

const works = [
  {
    href: "/godfrey",
    title: "Captain Godfrey",
    text: "A historical character visitors can question in real time. Explore the September 2026 exhibition and its recorded interactions.",
    image: "/images/godfrey/visitors.jpg",
    alt: "Visitors seated in front of Captain Godfrey at the Georgette 150th exhibition",
  },
  {
    href: "/work/cuborama",
    title: "Cuborama",
    text: "Four walls of projected imagery create a room visitors can step into.",
    image: "/images/photography/georgette/installation.jpg",
    alt: "John Bowskill seated in a dark room while underwater photographs are projected across the walls",
  },
  {
    href: "/work/drift",
    title: "Drift",
    text: "A photographic display that changes in response to the viewer’s position.",
  },
  {
    href: "/work/layer-painter",
    title: "Layer Painter",
    text: "Software and projection guide the transfer of a chosen image into a physical painting.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/work"
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Interactive works", path: "/work" },
  ])}
>
  <header class="page-hero">
    <div class="wrap">
      <h1 class="page-title">Interactive works</h1>
      <p class="lede">
        I develop experiences that respond to people: through conversation, movement, projected environments and the process of making a painting. Explore the work and the different ways it can connect people with images and stories.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="project-grid">
        {works.map((work) => (
          <a class="project-card-link" href={work.href}>
            {work.image && (
              <img src={work.image} alt={work.alt} width="1800" height="1200" loading="lazy" decoding="async" />
            )}
            <h2>{work.title}</h2>
            <p>{work.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Have a setting or a story in mind?</h2>
      <p class="lede">Tell me about the space, audience and material you would like to work with.</p>
      <ContactCTA href="/contact" label="Discuss an installation" />
    </div>
  </section>
</BaseLayout>
