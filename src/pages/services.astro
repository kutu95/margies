---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage } from "../lib/pages";
import { breadcrumbJsonLd } from "../lib/seo";

const page = await getPage("services");
const closing = await getPage("services-closing");
const { Content } = await render(page);
const { Content: Closing } = await render(closing);
const title = page.data.seoTitle ?? "Services — John Bowskill";
const description = page.data.seoDescription ?? "";
---

<BaseLayout
  title={title}
  description={description}
  path="/services"
  jsonLd={breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
  ])}
>
  <header class="page-hero">
    <div class="wrap-narrow">
      <p class="section-kicker">{page.data.kicker}</p>
      <h1 class="page-title">{page.data.headline}</h1>
      <p class="lede">{page.data.lede}</p>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap-narrow prose">
      <Content />
    </div>
  </section>

  {page.data.kinds && page.data.kinds.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-title">{page.data.kindsTitle}</h2>
        <div class="capability-grid" style="margin-top: 2rem;">
          {page.data.kinds.map((item) => (
            <article class="service">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-tight">
    <div class="wrap-narrow prose">
      <Closing />
    </div>
  </section>
</BaseLayout>
