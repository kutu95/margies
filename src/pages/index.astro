---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCard from "../components/CollectionCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config/site";
import { getFeaturedPhotography } from "../lib/photography";
import { getFeaturedProjects } from "../lib/projects";
import { personJsonLd, websiteJsonLd } from "../lib/seo";

const featured = await getFeaturedProjects();
const featuredPhotography = await getFeaturedPhotography();
---

<BaseLayout
  title={site.title}
  description={site.description}
  path="/"
  image="/images/photography/coast/little-rock.jpg"
  imageAlt="A winter wave breaking over dark rocks on the Margaret River coast"
  jsonLd={[personJsonLd(), websiteJsonLd()]}
>
  <section class="photo-hero">
    <figure class="photo-hero-media">
      <img
        src="/images/photography/coast/little-rock.jpg"
        alt="A winter wave crashing against dark coastal rocks, with white spray and a heavy sky"
        width="2000"
        height="1333"
        fetchpriority="high"
      />
    </figure>
    <div class="wrap">
      <div class="photo-hero-copy">
        <p class="eyebrow">{site.region}</p>
        <h1 class="display">I make photographs, software and unusual things.</h1>
        <p class="lede">
          Photography, creative technology and custom digital systems — usually following
          an idea or a real-world problem wherever it leads.
        </p>
        <div class="hero-actions">
          <a class="button" href="/photography">Photography</a>
          <a class="button button-ghost" href="/projects">Projects</a>
          <a class="button button-ghost" href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="section-kicker">Selected photography</p>
          <h2 class="section-title">Pictures that stand alone, and some that didn’t.</h2>
        </div>
        <a href="/photography">All photography</a>
      </div>
      <div class="collection-grid">
        {featuredPhotography.map((collection) => (
          <CollectionCard collection={collection} />
        ))}
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="section-kicker">Selected work</p>
          <h2 class="section-title">Featured projects</h2>
        </div>
        <a href="/projects">All projects</a>
      </div>
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <p class="section-kicker">What the work looks like</p>
      <h2 class="section-title">Creative and technical problem-solving.</h2>
      <div class="capability-grid" style="margin-top: 2rem;">
        <article class="capability">
          <h3>Photography</h3>
          <p>Coastal, underwater and documentary pictures — and the projects that grow out of them.</p>
        </article>
        <article class="capability">
          <h3>Custom applications</h3>
          <p>Web tools shaped around a real workflow, not a generic product category.</p>
        </article>
        <article class="capability">
          <h3>Exhibition and immersive work</h3>
          <p>Projection, interaction and digital reconstruction for rooms that have to do more than hang pictures.</p>
        </article>
      </div>
      <p style="margin-top: 2rem;">
        <a href="/services">How I take on this kind of work</a>
      </p>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap split-grid">
      <div>
        <p class="section-kicker">About</p>
        <h2 class="section-title">The common thread isn’t the medium. It’s curiosity and solving the problem.</h2>
      </div>
      <div>
        <p>
          I’m John Bowskill. I live near Margaret River in Western Australia. I’ve worked as a
          veterinarian, run an aquaponics farm, photographed a shipwreck for years, and spent a
          lot of time building the software and electronics that those jobs quietly required.
        </p>
        <p>
          Photography, software, farming, electronics and immersive rooms are different
          expressions of the same habit: follow the idea until the useful thing exists.
        </p>
        <p><a href="/about">More about the work</a></p>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap">
      <h2 class="section-title">Have a problem that doesn’t have an off-the-shelf solution?</h2>
      <p>I can probably build something for it. Or tell you quickly if I can’t.</p>
      <div class="hero-actions" style="margin-top: 1.5rem;">
        <a class="button" href="/contact">Get in touch</a>
        <a class="button button-ghost" href="/projects">Look at the work</a>
      </div>
    </div>
  </section>
</BaseLayout>
