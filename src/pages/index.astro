---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCard from "../components/CollectionCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config/site";
import { getPage } from "../lib/pages";
import { getFeaturedPhotography } from "../lib/photography";
import { getFeaturedProjects } from "../lib/projects";
import { personJsonLd, websiteJsonLd } from "../lib/seo";

const page = await getPage("home");
const copy = page.data;
const featured = await getFeaturedProjects();
const featuredPhotography = await getFeaturedPhotography();
---

<BaseLayout
  title={site.title}
  description={site.description}
  path="/"
  image={copy.heroImage}
  imageAlt={copy.heroAlt}
  jsonLd={[personJsonLd(), websiteJsonLd()]}
>
  <section class="photo-hero">
    <figure class="photo-hero-media">
      <img
        src={copy.heroImage}
        alt={copy.heroAlt ?? ""}
        width="2000"
        height="1333"
        fetchpriority="high"
      />
    </figure>
    <div class="wrap">
      <div class="photo-hero-copy">
        <p class="eyebrow">{site.region}</p>
        <h1 class="display">{copy.headline}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button" href="/photography">Photography</a>
          <a class="button button-ghost" href="/projects">Projects</a>
          <a class="button button-ghost" href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="section-kicker">{copy.photoKicker}</p>
          <h2 class="section-title">{copy.photoTitle}</h2>
        </div>
        <a href="/photography">{copy.photoLink}</a>
      </div>
      <div class="collection-grid">
        {featuredPhotography.map((collection) => (
          <CollectionCard collection={collection} />
        ))}
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="section-kicker">{copy.projectsKicker}</p>
          <h2 class="section-title">{copy.projectsTitle}</h2>
        </div>
        <a href="/projects">{copy.projectsLink}</a>
      </div>
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <p class="section-kicker">{copy.workKicker}</p>
      <h2 class="section-title">{copy.workTitle}</h2>
      <div class="capability-grid" style="margin-top: 2rem;">
        {copy.capabilities?.map((item) => (
          <article class="capability">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem;">
        <a href="/services">{copy.workLink}</a>
      </p>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap split-grid">
      <div>
        <p class="section-kicker">{copy.aboutKicker}</p>
        <h2 class="section-title">{copy.aboutTitle}</h2>
      </div>
      <div>
        {copy.aboutParagraphs?.map((paragraph) => <p>{paragraph}</p>)}
        <p><a href="/about">{copy.aboutLink}</a></p>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap">
      <h2 class="section-title">{copy.ctaTitle}</h2>
      <p>{copy.ctaText}</p>
      <div class="hero-actions" style="margin-top: 1.5rem;">
        <a class="button" href="/contact">Get in touch</a>
        <a class="button button-ghost" href="/projects">Look at the work</a>
      </div>
    </div>
  </section>
</BaseLayout>
