---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { getPage } from "../lib/pages";
import { getStudy, getWorks, hasPhotograph, projectPath } from "../lib/projects";
import { organizationJsonLd, personJsonLd, websiteJsonLd } from "../lib/seo";

const page = await getPage("home");
const copy = page.data;
const works = await getWorks();
const [lead, ...rest] = works;
const study = await getStudy();
---

<BaseLayout
  title={site.title}
  description={site.description}
  path="/"
  image={copy.heroImage}
  imageAlt={copy.heroAlt}
  jsonLd={[personJsonLd(), organizationJsonLd(), websiteJsonLd()]}
>
  <section class="opening">
    <figure class="opening-media">
      <img
        src={copy.heroImage}
        alt={copy.heroAlt ?? ""}
        width="1800"
        height="1200"
        fetchpriority="high"
      />
    </figure>
    <div class="wrap opening-copy">
      <p class="eyebrow">{site.name}</p>
      <h1 class="display">{copy.headline}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="hero-actions">
        <a class="button" href="/contact">Enquire</a>
      </div>
    </div>
  </section>

  {lead && (
    <section class="lead-work">
      <div class="wrap">
        <p class="eyebrow">Work</p>
        <h2 class="lead-title">{lead.data.title}</h2>
        {lead.data.pitch && <p class="lead-pitch">{lead.data.pitch}</p>}
        <p class="lead-summary">{lead.data.summary}</p>
        <p class="lead-link">
          <a href={projectPath(lead)}>{lead.data.title}</a>
        </p>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="section">
      <div class="wrap work-list">
        {rest.map((work) => (
          <a class="work-row" href={projectPath(work)}>
            <h2>{work.data.title}</h2>
            <p>{work.data.pitch ?? work.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {study && (
    <section class="section">
      <div class="wrap study-grid">
        {hasPhotograph(study.data.hero) && (
          <img
            src={study.data.hero}
            alt={study.data.heroAlt}
            width="1400"
            height="788"
            loading="lazy"
            decoding="async"
          />
        )}
        <div>
          <p class="section-kicker">Case study</p>
          <h2 class="section-title">{study.data.title}</h2>
          <p>{study.data.pitch ?? study.data.summary}</p>
          <div class="hero-actions">
            <a class="button" href={projectPath(study)}>Georgette 150th</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section cta">
    <div class="wrap">
      <h2 class="section-title">{copy.ctaTitle}</h2>
      <p>{copy.ctaText}</p>
      <div class="hero-actions" style="margin-top: 1.5rem;">
        <a class="button" href="/contact">Enquire</a>
      </div>
    </div>
  </section>
</BaseLayout>
