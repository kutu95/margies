---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../config/site";
import { getFeaturedProjects } from "../lib/projects";
import { personJsonLd, websiteJsonLd } from "../lib/seo";

const featured = await getFeaturedProjects();
---

<BaseLayout
  title={site.title}
  description={site.description}
  path="/"
  jsonLd={[personJsonLd(), websiteJsonLd()]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{site.region}</p>
        <h1 class="display">I build useful things with software, AI and electronics.</h1>
        <p class="lede">
          Custom software, interactive experiences, monitoring systems and technical
          prototypes — usually for problems where nothing off the shelf quite fits.
        </p>
        <div class="hero-actions">
          <a class="button" href="/projects">Projects</a>
          <a class="button button-ghost" href="/about">About</a>
          <a class="button button-ghost" href="/contact">Contact</a>
        </div>
      </div>
      <figure class="hero-figure">
        <img
          src="/images/projects/georgette/hero.jpg"
          alt="Aerial photograph of the SS Georgette wreck in clear water off Redgate Beach, near Margaret River"
          width="1200"
          height="900"
          fetchpriority="high"
        />
        <figcaption>SS Georgette, Redgate Beach — a project that became an exhibition, a book, and a set of installations.</figcaption>
      </figure>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="section-kicker">Selected work</p>
          <h2 class="section-title">Featured projects</h2>
        </div>
        <a href="/projects">All projects</a>
      </div>
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap">
      <p class="section-kicker">What I build</p>
      <h2 class="section-title">Software for odd, specific problems.</h2>
      <div class="capability-grid" style="margin-top: 2rem;">
        <article class="capability">
          <h3>Custom applications</h3>
          <p>Web tools shaped around a real workflow, not a generic product category.</p>
        </article>
        <article class="capability">
          <h3>Sensors and dashboards</h3>
          <p>Arduino, Raspberry Pi and wireless networks that watch a place and say when something is wrong.</p>
        </article>
        <article class="capability">
          <h3>Exhibition technology</h3>
          <p>Projection, interaction and digital reconstruction for rooms that have to do more than hang pictures.</p>
        </article>
      </div>
      <p style="margin-top: 2rem;">
        <a href="/services">How I take on this kind of work</a>
      </p>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap split-grid">
      <div>
        <p class="section-kicker">About</p>
        <h2 class="section-title">The common thread isn’t the industry. It’s solving the problem.</h2>
      </div>
      <div>
        <p>
          I’m John Bowskill. I live near Margaret River in Western Australia. I’ve worked as a
          veterinarian, run an aquaponics farm, photographed a shipwreck for years, and spent a
          lot of time building the software and electronics that those jobs quietly required.
        </p>
        <p>
          I tend to end up making the thing that should already exist. Sometimes that’s a
          reporting tool. Sometimes it’s a sensor network. Sometimes it’s a digital captain
          visitors can talk to.
        </p>
        <p><a href="/about">More about the work</a></p>
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap">
      <h2 class="section-title">Have a problem that doesn’t have an off-the-shelf solution?</h2>
      <p>I can probably build something for it. Or tell you quickly if I can’t.</p>
      <div class="hero-actions" style="margin-top: 1.5rem;">
        <a class="button" href="/contact">Get in touch</a>
        <a class="button button-ghost" href="/projects">Look at the work</a>
      </div>
    </div>
  </section>
</BaseLayout>
