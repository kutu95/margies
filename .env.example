# Optional contact-form backend. Leave empty to use the mailto fallback.
# Example: a Formspree, Getform, or Cloudflare Worker URL that accepts JSON.
PUBLIC_CONTACT_FORM_ENDPOINT=

# Admin — /admin is disabled until ADMIN_PASSWORD is set.
# Copy this file to .env on the server and choose a long password.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
